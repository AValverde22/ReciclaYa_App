<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RecojoActionButton" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/gotham_bold</item>
        <item name="android:background">@drawable/button_final_green_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="RecojoSecondaryButton" parent="RecojoActionButton">
        <item name="android:background">@drawable/button_final_green_border</item>
        <item name="android:textColor">@color/verde</item>
    </style>
    <style name="RecojoCancelButton" parent="RecojoActionButton">
        <item name="android:background">@drawable/button_final_red_background</item>
    </style>
</resources>
