<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.auth.verificacion.VerificacionActivity">

    <LinearLayout
        android:id="@+id/LLLoadingVC"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gris_transparente"
        android:elevation="2dp"
        android:gravity="center"

        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/verde_claro" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.1">

            <ImageView
                android:id="@+id/IVRegresarVC"
                android:layout_width="15dp"
                android:layout_height="15dp"

                android:layout_gravity="center_vertical"
                android:layout_marginStart="30dp"
                android:background="@drawable/flechaizquierda"
                android:contentDescription="@string/Cancelar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:fontFamily="@font/gothamnarrow_medium"

                android:gravity="center"
                android:text="@string/verificacion_titulo"
                android:textColor="@color/black"
                android:textSize="19sp" />
        </FrameLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0.05dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_weight="0.9"
            android:paddingHorizontal="30dp">

            <ImageView
                android:id="@+id/IVVerificarVC"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/verificar_codigo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/TVTituloVC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="15dp"
                android:fontFamily="@font/gotham_bold"
                android:text="@string/VerificarCodigo"
                android:textColor="@color/black"
                android:textSize="24sp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/IVVerificarVC" />

            <TextView
                android:id="@+id/TVMensajeVC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"

                android:fontFamily="@font/gothamnarrow_medium"
                android:gravity="center"
                android:text="@string/MensajeVerificarCodigo"
                android:textColor="@color/gris"
                android:textSize="14sp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/TVTituloVC" />

            <TextView
                android:id="@+id/TVCorreoVC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"

                android:fontFamily="@font/gotham_bold"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="14sp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/TVMensajeVC" />

            <LinearLayout
                android:id="@+id/LLCodigoVC"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginHorizontal="20dp"

                android:layout_marginTop="20dp"
                android:orientation="horizontal"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/TVCorreoVC">

                <androidx.cardview.widget.CardView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2.5dp"

                    app:cardBackgroundColor="@color/gris_claro"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/ETCod1VC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:background="@color/transparente"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textAlignment="center"

                        android:textColor="@color/black"
                        android:textSize="20sp" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2.5dp"

                    app:cardBackgroundColor="@color/gris_claro"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/ETCod2VC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:background="@color/transparente"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textAlignment="center"

                        android:textColor="@color/black"
                        android:textSize="20sp" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2.5dp"

                    app:cardBackgroundColor="@color/gris_claro"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/ETCod3VC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:background="@color/transparente"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textAlignment="center"

                        android:textColor="@color/black"
                        android:textSize="20sp" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2.5dp"

                    app:cardBackgroundColor="@color/gris_claro"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/ETCod4VC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:background="@color/transparente"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textAlignment="center"

                        android:textColor="@color/black"
                        android:textSize="20sp" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2.5dp"

                    app:cardBackgroundColor="@color/gris_claro"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/ETCod5VC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:background="@color/transparente"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textAlignment="center"

                        android:textColor="@color/black"
                        android:textSize="20sp" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2.5dp"

                    app:cardBackgroundColor="@color/gris_claro"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/ETCod6VC"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:background="@color/transparente"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textAlignment="center"

                        android:textColor="@color/black"
                        android:textSize="20sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView
                android:id="@+id/TVReenviarCodigoVC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"
                android:padding="5dp"

                android:fontFamily="@font/gotham_medium"
                android:text="@string/verificacion_reenviar"
                android:textColor="@color/verde"
                android:textSize="14sp"
                android:textStyle="bold"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/LLCodigoVC" />

            <Button
                android:id="@+id/BtnVerificarVC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"
                android:background="@drawable/green_button_background"

                android:text="@string/verificacion_boton"
                android:textAllCaps="false"

                android:textColor="@color/white"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/TVReenviarCodigoVC" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
