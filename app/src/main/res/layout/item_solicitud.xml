<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:id="@+id/MCVFondoIS"
    android:theme="@style/Theme.MaterialComponents.Light"
    app:cardBackgroundColor="@color/verde_transparente"
    app:cardCornerRadius="15dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/gris_claro"
    app:strokeWidth="1dp"

    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="25dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"

            android:background="@color/transparente"
            android:layout_weight="0.25"
            android:gravity="center"
            >

            <ImageView
                android:id="@+id/IVTipoResiduoIS"
                android:layout_width="25dp"
                android:layout_height="25dp"

                android:background="@drawable/plastico"
                android:backgroundTint="@color/verde"
                />

            <TextView
                android:id="@+id/TVTipoResiduoIS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/gotham_medium"
                android:textColor="@color/verde"
                android:textSize="12sp"
                android:text="@string/Plastico"
                />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="0.1dp"
            android:layout_height="match_parent"

            app:cardBackgroundColor="@color/gris_claro"
            app:cardElevation="1dp"
        >

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="0.75"

            android:background="@color/white"
            android:padding="10dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                >

                <TextView
                    android:id="@+id/TVTamanoIS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:text="@string/Tamano"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/gotham_bold"
                    />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    >

                    <Button
                        android:id="@+id/BtnCancelarIS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        style="?android:attr/buttonStyleSmall"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="10dp"

                        android:text="@string/Cancelar"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:textAllCaps="false"

                        android:background="@drawable/button_final_brown_background"
                        />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/CVDistanciaIS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        app:cardBackgroundColor="@color/gris_claro"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/TVDistanciaIS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="7.5dp"
                            android:layout_marginVertical="2.5dp"

                            android:fontFamily="@font/gotham_bold"
                            android:text="0.8 km"
                            android:textColor="@color/black"
                            android:textSize="10sp" />

                    </androidx.cardview.widget.CardView>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                >

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"

                    android:layout_marginEnd="5dp"
                    >

                    <ImageView
                        android:id="@+id/IVFotoPerfilIS"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        tools:srcCompat="@tools:sample/avatars"
                    />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/TVNombreUsuarioIS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:text="@string/NombrePendiente"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/gothamnarrow_medium"
                />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    >

                    <Button
                        android:id="@+id/BtnEditarIS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        style="?android:attr/buttonStyleSmall"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="10dp"

                        android:text="@string/Editar"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:textAllCaps="false"

                        android:background="@drawable/button_final_green_background"
                        />

                    <LinearLayout
                        android:id="@+id/LLPuntuacionIS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        >

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"

                            android:background="@drawable/estrella"
                            />

                        <TextView
                            android:id="@+id/TVPuntuacionIS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="1dp"

                            android:text="4.8"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/gotham_bold"
                            />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="1dp"

                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/gris_claro"

                android:layout_marginBottom="10dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                android:layout_marginBottom="5dp"
                >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginEnd="10dp"

                    android:gravity="center_vertical"
                    >

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"

                        android:layout_marginEnd="5dp"
                        android:background="@drawable/reloj"
                        android:backgroundTint="@color/gris_intermedio" />

                    <TextView
                        android:id="@+id/TVAntiguedadIS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:fontFamily="@font/gotham_medium"
                        android:text="Hace 25 min"
                        android:textColor="@color/gris_intermedio"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:orientation="horizontal"
                    android:gravity="center_vertical|end"
                    >

                    <ImageView
                        android:id="@+id/IVPinIS"
                        android:layout_width="10dp"
                        android:layout_height="15dp"

                        android:layout_marginEnd="5dp"
                        android:background="@drawable/locacion"
                    />

                    <TextView
                        android:id="@+id/TVDireccionIS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:ellipsize="end"
                        android:maxLines="1"

                        android:text="Av. Las Palmeras 123"
                        android:textSize="10sp"
                        android:textColor="@color/verde"
                        android:fontFamily="@font/gotham_medium"
                        />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>