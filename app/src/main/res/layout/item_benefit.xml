<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/linearlayout_transparente"
    android:orientation="vertical"
    android:padding="15dp">
    <TextView android:id="@+id/TVNombreBeneficio" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/gotham_bold" android:textColor="@color/black" android:textSize="14sp" />
    <TextView android:id="@+id/TVProveedorBeneficio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/gothamnarrow_medium" android:textColor="@color/verde" android:textSize="12sp" />
    <TextView android:id="@+id/TVDescripcionBeneficio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/gothamnarrow_medium" android:textColor="@color/gris" android:textSize="12sp" />
    <TextView android:id="@+id/TVCondicionesBeneficio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/gothamnarrow_medium" android:textColor="@color/gris_intermedio" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/TVPuntosBeneficio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/gotham_bold" android:textColor="@color/dorado" android:textSize="14sp" />
        <Button android:id="@+id/BtnCanjearBeneficio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/button_green" android:fontFamily="@font/gotham_bold" android:minHeight="42dp" android:text="Canjear" android:textAllCaps="false" android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
