<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"

    android:orientation="vertical"
    tools:context=".ui.view.main.factory_method.main.UsuarioMainActivity">

    <LinearLayout
        android:id="@+id/LLLoadingFMP"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gris_transparente"
        android:elevation="2dp"
        android:gravity="center"

        android:orientation="vertical"
        android:visibility="gone"
        >

        <ProgressBar
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/verde_claro"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"

            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="15dp">

            <androidx.cardview.widget.CardView
                android:layout_width="35dp"
                android:layout_height="35dp"

                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/reciclaya_negro" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/TVSubtituloMain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"

                android:fontFamily="@font/gotham_bold"

                android:gravity="center"
                android:text="@string/MiPerfil"
                android:textColor="@color/black"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/IVConfiguracionMain"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/configuracion" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0.05dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">


            <LinearLayout
                android:id="@+id/LL2FMP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"

                android:background="@drawable/linearlayout_verde_perfil"
                android:orientation="horizontal"

                android:padding="15dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="75dp"
                    android:layout_height="75dp"

                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:src="@tools:sample/avatars" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"

                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/TVNombreFMP"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.3"

                        android:fontFamily="@font/gotham_bold"
                        android:text="@string/NombreCompleto"
                        android:textColor="@color/black"
                        android:textSize="17.5sp" />

                    <TextView
                        android:id="@+id/TVCorreoFMP"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.2"

                        android:ellipsize="end"
                        android:fontFamily="@font/gothamnarrow_medium"
                        android:maxLines="1"
                        android:text="@string/CorreoEjemplo"
                        android:textColor="@color/gris_intermedio"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.5"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:backgroundTint="@color/verde"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/TVRolFMP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginHorizontal="10dp"

                                android:fontFamily="@font/gothamnarrow_medium"
                                android:text="@string/Usuario"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"

                            android:background="@drawable/linearlayout_dorado"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/textView12"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginHorizontal="10dp"

                                android:fontFamily="@font/gothamnarrow_medium"
                                android:text="NIVEL 4"
                                android:textAllCaps="true"
                                android:textColor="@color/dorado"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/TV1FMP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"
                android:fontFamily="@font/gotham_bold"
                android:text="@string/MiActividad"
                android:textAllCaps="true"
                android:textColor="@color/gris_intermedio"

                android:textSize="11sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/RVFMP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:paddingTop="5dp"
                />

            <LinearLayout
                android:id="@+id/LLCerrarSesionFMP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"

                android:background="@drawable/linearlayout_rojo"
                android:gravity="center"
                android:orientation="horizontal"

                android:paddingVertical="12.5dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"

                    android:layout_marginEnd="10dp"
                    android:background="@drawable/cerrar_sesion"
                    android:backgroundTint="@color/rojo_dos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/gothamnarrow_medium"
                    android:text="@string/CerrarSesion"
                    android:textColor="@color/rojo_dos"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>