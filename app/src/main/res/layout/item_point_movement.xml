<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/linearlayout_transparente"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/TVDescripcionMovimiento" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/gotham_bold" android:textColor="@color/black" android:textSize="12sp" />
        <TextView android:id="@+id/TVFechaMovimiento" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/gothamnarrow_medium" android:textColor="@color/gris" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/TVPuntosMovimiento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="@font/gotham_bold" android:textSize="16sp" />
</LinearLayout>
