<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/MCVFondoIA"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="15dp"
    android:layout_marginVertical="6dp"

    android:clickable="true"
    android:focusable="true"

    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="5dp"
    app:cardElevation="1dp"
    app:strokeColor="#D5D5D5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Identificador y estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TVIdentificadorIA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/gotham_bold"
                android:text="ACCESO #000"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/TVEstadoIA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:text="AUTORIZADO"
                android:textColor="@color/verde_claro"
                android:textSize="11sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/TVTipoActividadIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gotham_bold"
            android:text="Inicio de sesión"
            android:textColor="@color/black"
            android:textSize="13sp" />


        <TextView
            android:id="@+id/TVFechaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:text="01/11/2026 · 10:42 AM"
            android:textColor="#555555"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/TVUbicacionIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:text="Lima, Perú"
            android:textColor="#555555"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:text="CONSULTAR REGISTRO  →"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:fontFamily="@font/gotham_bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>