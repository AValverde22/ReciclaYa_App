<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    app:cardBackgroundColor="@color/gris_intermedio"
    app:cardCornerRadius="15dp"

    android:layout_marginHorizontal="25dp"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"

        android:layout_margin="3dp"
        app:contentPadding="20dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/EliminarSolicitud"

                android:textSize="15sp"
                android:textColor="@color/black"
                android:fontFamily="@font/gotham_bold"
                android:textAlignment="center"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/MensajeEliminarSolicitud"

                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"

                android:textSize="12sp"
                android:textColor="@color/gris_intermedio"
                android:textAlignment="center"
                android:fontFamily="@font/gotham_bold"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <Button
                    android:id="@+id/BtnRegresarADES"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    style="?android:attr/buttonStyleSmall"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"

                    android:text="@string/Regresar"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/gothamnarrow_medium"
                    android:textAllCaps="false"

                    android:background="@drawable/button_final_green_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

                <Button
                    android:id="@+id/BtnAceptarADES"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    style="?android:attr/buttonStyleSmall"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"

                    android:text="@string/Aceptar"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/gothamnarrow_medium"
                    android:textAllCaps="false"

                    android:background="@drawable/button_final_brown_background"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.cardview.widget.CardView>