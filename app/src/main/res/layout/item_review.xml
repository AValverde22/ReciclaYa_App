<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/linearlayout_transparente" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/IVAutorReview" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/foto_en_blanco" android:scaleType="centerCrop" android:contentDescription="Autor de la reseña" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/TVAutorReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/gotham_bold" android:textColor="@color/black" android:textSize="13sp" />
            <TextView android:id="@+id/TVFechaReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/gothamnarrow_medium" android:textColor="@color/gris" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/TVEstrellasReview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/gotham_bold" android:textColor="@color/dorado" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:id="@+id/TVComentarioReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="@font/gothamnarrow_medium" android:textColor="@color/gris_intermedio" android:textSize="12sp" />
</LinearLayout>
