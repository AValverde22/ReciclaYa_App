<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/LLFondoITR"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/linearlayout_transparente"

    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginHorizontal="7.5dp"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/CVFondoIconoITR"
        app:cardBackgroundColor="@color/gris_claro"
        app:cardCornerRadius="50dp"

        app:cardElevation="0dp"
        android:layout_width="50dp"
        android:layout_height="50dp">

        <ImageView
            android:id="@+id/IVIconoITR"
            android:layout_width="25dp"
            android:layout_height="25dp"

            android:layout_gravity="center"
            android:backgroundTint="@color/black" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/TVTipoITR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:fontFamily="@font/gotham_medium"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="12sp" />

</LinearLayout>