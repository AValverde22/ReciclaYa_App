<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="15dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="6dp"
    app:cardElevation="1dp"
    app:strokeColor="#D5D5D5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TVIdReporteIRA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="REPORTE #001"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:fontFamily="@font/gotham_bold" />

            <TextView
                android:id="@+id/TVEstadoReporteIRA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRADO"
                android:textColor="@color/verde_claro"
                android:textSize="11sp"
                android:fontFamily="@font/gotham_bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/TVAccesoReporteIRA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acceso reportado #001"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:fontFamily="@font/gotham_bold" />

        <TextView
            android:id="@+id/TVActividadReporteIRA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Inicio de sesión"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/TVFechaReporteIRA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="01/11/2026"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/TVDescripcionReporteIRA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Descripción del reporte"
            android:textColor="@color/black"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>