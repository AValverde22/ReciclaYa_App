<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="horizontal"
    android:background="@drawable/linearlayout_transparente"
    android:padding="15dp"
    android:gravity="center"

    android:layout_marginBottom="10dp"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="45dp"
        android:layout_height="45dp"

        app:cardBackgroundColor="@color/gris_claro"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/IVLogoActividadIMA"
            android:layout_width="20dp"
            android:layout_height="20dp"

            android:layout_gravity="center"
            android:background="@drawable/recientes"
            android:backgroundTint="@color/verde" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="15dp"

        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TVActividadIMA"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fontFamily="@font/gotham_bold"

            android:gravity="center_vertical"
            android:text="Historial de Solicitudes"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/TVMensajeActividadIMA"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fontFamily="@font/gothamnarrow_medium"

            android:gravity="center_vertical"
            android:text="Mensaje Historial De Solicitudes"
            android:textColor="@color/gris"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="10dp"
        android:layout_height="10dp"

        android:background="@drawable/flechaizquierda"
        android:rotation="180" />
</LinearLayout>